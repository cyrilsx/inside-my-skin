# Production env template — copy to .env.prod (gitignored), fill in, chmod 600.
# On Infomaniak Jelastic Public Cloud, set these as environment variables in the
# Jelastic dashboard instead (they are stored encrypted there); see docs/deployment/infomaniak.md.

# --- master secrets (generate: head -c 32 /dev/urandom | base64) ---
POSTGRES_PASSWORD=
JWT_SIGNING_KEY=
TOKEN_ENCRYPTION_KEY=
WEBHOOK_SECRET=

# --- app ---
POSTGRES_USER=healthhub
POSTGRES_DB=healthhub
SYNC_ENABLED=true

# --- providers: enable + set credentials here, or via the dashboard Sources UI ---
GARMIN_ENABLED=false
GARMIN_PERSONAL_KEY=
GARMIN_KEY_HEADER=
GARMIN_USER_ID=
WITHINGS_ENABLED=false
WITHINGS_CLIENT_ID=
WITHINGS_CLIENT_SECRET=
WITHINGS_CALLBACK_SECRET=
WITHINGS_REDIRECT_URI=https://YOUR-DOMAIN/connect/withings/callback
